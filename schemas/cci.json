{
  "required": [
    "display_name",
    "resource_pool",
    "scheduling"
  ],
  "type": "object",
  "properties": {
    "name": {
      "maxLength": 63,
      "minLength": 1,
      "type": "string",
      "description": "应用名称。不填写，则由后台默认随机生成。若填入，则需要遵循以下规范： 1. 1～63 个字符。 2. 小写字母开头，小写字母或数字结尾。 3. 可包含小写英文字母、数字、中划线（-）"
    },
    "display_name": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string",
      "description": "应用显示名称。填写需要遵循以下规则： 1. 1～256 个字符。 2. 以中文字符、英文字母或数字开头。 3. 由中文字符、英文字母、数字、点号（.）、半角冒号（:）、下划线（_）和 连字符（-）组成"
    },
    "uid": {
      "readOnly": true,
      "type": "string",
      "description": "应用唯一标识"
    },
    "id": {
      "readOnly": true,
      "type": "string",
      "description": "应用 ID"
    },
    "ownership": {
      "readOnly": true,
      "allOf": [
        {
          "type": "object",
          "properties": {
            "user_name": {
              "readOnly": true,
              "type": "string",
              "description": "用户名"
            },
            "user_id": {
              "readOnly": true,
              "type": "string",
              "description": "用户 ID"
            },
            "tenant_id": {
              "readOnly": true,
              "type": "string",
              "description": "租户 ID"
            },
            "requestor_id": {
              "readOnly": true,
              "type": "string",
              "description": "发起请求者或第三方发起者的 ID"
            }
          },
          "description": "所有权关系",
          "title": "Ownership"
        }
      ],
      "description": "所有权关系"
    },
    "template": {
      "allOf": [
        {
          "required": [
            "containers",
            "resource_spec"
          ],
          "type": "object",
          "properties": {
            "init_containers": {
              "type": "array",
              "items": {
                "required": [
                  "image_path",
                  "resource_request"
                ],
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "容器名称"
                  },
                  "image_path": {
                    "type": "string",
                    "description": "镜像地址"
                  },
                  "command": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "容器命令列表。命令不会在 shell 中运行，传统的 shell 指令（如 '|'）无效。如果需要使用 shell，需显式调用。 注意：当前端请求（通过 x-ui-valid 头标识）时，系统会自动将命令包装为 [\"bash\", \"-c\", ...原始命令...] 以支持 shell 语法。非前端请求保持原始格式"
                  },
                  "env": {
                    "type": "array",
                    "items": {
                      "required": [
                        "name",
                        "value",
                        "need_mosaic"
                      ],
                      "type": "object",
                      "properties": {
                        "name": {
                          "maxLength": 255,
                          "type": "string",
                          "description": "环境变量名称。 可以包含字母(A-Z, a-z)、数字(0-9)、下划线(_)、点(.)或短横线(-)， 但第一个字符不能是数字。参考: https://kubernetes.io/docs/tasks/inject-data-application/define-environment-variable-container/"
                        },
                        "value": {
                          "type": "string",
                          "description": "环境变量值"
                        },
                        "need_mosaic": {
                          "type": "boolean",
                          "description": "是否需要马赛克处理"
                        }
                      },
                      "description": "环境变量",
                      "title": "EnvVar"
                    },
                    "description": "容器环境变量列表"
                  },
                  "resource_request": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "容器资源请求。如果为空，则使用资源规格中的默认值"
                  },
                  "volume_mounts": {
                    "type": "array",
                    "items": {
                      "required": [
                        "type"
                      ],
                      "type": "object",
                      "properties": {
                        "type": {
                          "enum": [
                            "MOUNT_TYPE_UNSPECIFIED",
                            "PV_AFS",
                            "CONFIGMAP",
                            "SECRET",
                            "PV_ACS",
                            "PV_AOSS"
                          ],
                          "type": "string",
                          "description": "挂载类型",
                          "format": "enum"
                        },
                        "name": {
                          "type": "string",
                          "description": "卷名称"
                        },
                        "mount_path": {
                          "type": "string",
                          "description": "挂载路径"
                        },
                        "id": {
                          "type": "string",
                          "description": "卷 ID"
                        },
                        "volume_capacity": {
                          "type": "string",
                          "description": "卷容量"
                        },
                        "subdir": {
                          "type": "string",
                          "description": "指定挂载卷下的子目录"
                        },
                        "zone": {
                          "type": "string",
                          "description": "可用区"
                        },
                        "endpoint": {
                          "type": "string",
                          "description": "挂载卷的 endpoint"
                        },
                        "mount_options": {
                          "type": "string",
                          "description": "挂载选项。当前仅支持通过 GeeseFS 挂载 AOSS 时的相关配置。 示例：--no-preload-dir --uid=1000 其中 no-preload-dir 表示关闭预加载功能，uid=1000 表示设置文件所有者为用户ID1000"
                        }
                      },
                      "description": "卷挂载",
                      "title": "VolumeMount"
                    },
                    "description": "卷挂载"
                  },
                  "liveness_probe": {
                    "allOf": [
                      {
                        "required": [
                          "probe_type"
                        ],
                        "type": "object",
                        "properties": {
                          "probe_type": {
                            "enum": [
                              "PROBE_TYPE_UNSPECIFIED",
                              "EXEC",
                              "HTTP_GET"
                            ],
                            "type": "string",
                            "description": "探针类型，目前仅支持 exec 类型",
                            "format": "enum"
                          },
                          "exec": {
                            "allOf": [
                              {
                                "required": [
                                  "command"
                                ],
                                "type": "object",
                                "properties": {
                                  "command": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    },
                                    "description": "使用命令行方式进行健康检查时，在容器内执行的命令。该命令不会在 shell 中运行，因此传统的 shell 指令（如 '|'）无效。如果需要使用 shell，需显式调用。退出状态码为 0 表示存活/健康，非 0 表示不健康"
                                  }
                                },
                                "description": "命令行探针",
                                "title": "Exec"
                              }
                            ],
                            "description": "命令行探针"
                          },
                          "initial_delay_seconds": {
                            "type": "integer",
                            "description": "首次检测延迟时间（秒），从容器启动完成开始计算",
                            "format": "int32"
                          },
                          "period_seconds": {
                            "type": "integer",
                            "description": "检测间隔时间（秒），默认为 10 秒，最小值为 1 秒",
                            "format": "int32"
                          },
                          "timeout_seconds": {
                            "minimum": 1,
                            "type": "integer",
                            "description": "探测超时时间（秒），默认为 1 秒，最小值为 1 秒",
                            "format": "int32"
                          },
                          "failure_threshold": {
                            "minimum": 1,
                            "type": "integer",
                            "description": "探测失败的阈值，连续失败次数达到该值后认为探针失败，默认为 3， 最小值为 1",
                            "format": "int32"
                          }
                        },
                        "description": "探针",
                        "title": "Probe"
                      }
                    ],
                    "description": "存活探针"
                  },
                  "readiness_probe": {
                    "allOf": [

function Pass($name) { Write-Host "✓ $name" }
function Fail($name) { Write-Warning "✗ $name" }
function Step($name, [scriptblock]$body, [scriptblock]$success, [switch]$Silent) {
    $showStep = -not $Silent
    $showProgress = $showStep -and -not [Console]::IsOutputRedirected
    if ($showProgress) {
        Write-Progress -Activity "SCO installer" -Status "$name..." -PercentComplete -1
    }
    try {
        & $body
        if ($showProgress) {
            Write-Progress -Activity "SCO installer" -Completed
        }
        if ($showStep) {
            $completedName = if ($success) { & $success } else { $name }
            Pass $completedName
        }
    } catch {
        if ($showProgress) {
            Write-Progress -Activity "SCO installer" -Completed
        }
        if ($showStep) {
            Fail $name
        }
        throw
    }
}
function Download-File($uri, $outFile) {
    Invoke-WebRequest -UseBasicParsing -Uri $uri -OutFile $outFile
}
function Read-ProductEnv($path) {
    $map = @{}
    foreach ($line in Get-Content $path) {
        if ($line -match '^([A-Z0-9_]+)=[''"]?(.*?)[''"]?$') { $map[$matches[1]] = $matches[2] }
    }
    return $map
}
function Upper-Region($code) { return $code.ToUpperInvariant().Replace('-', '_') }
function Region-Runtime($envMap, $code) { return $envMap["REGION_$(Upper-Region $code)_RUNTIME"] }
function Resolve-Url($uri) {
    if ($uri -match '^https?://') { return $uri }
    if ($uri.StartsWith("/")) { return "$repo$uri" }
    return "$repo/$uri"
}
function Yaml-Quote($value) {
    return "'" + ([string]$value).Replace("'", "''") + "'"
}
function Find-ScoPlatform($manifest, $scoVersion, $runtime) {
    $uri = ""; $sha = ""; $os = ""; $arch = ""; $rt = ""
    $candidateUri = ""; $candidateSha = ""; $hasVersion = $false
    foreach ($line in Get-Content $manifest) {
        if ($line -match '^\s*(?:-\s*)?version:\s*"?(.+?)"?\s*$') {
            if ($uri -and $sha -and $os -eq "windows" -and $arch -eq "amd64" -and $rt -eq $runtime) { $candidateUri = $uri; $candidateSha = $sha }
            if ($matches[1] -eq $scoVersion) {
                $hasVersion = $true
                if ($candidateUri -and $candidateSha) { return @($candidateUri, $candidateSha) }
            }
            $uri = ""; $sha = ""; $os = ""; $arch = ""; $rt = ""
            continue
        }
        if ($line -match '^\s*-\s+') {
            if ($uri -and $sha -and $os -eq "windows" -and $arch -eq "amd64" -and $rt -eq $runtime) {
                $candidateUri = $uri; $candidateSha = $sha
                if ($hasVersion) { return @($candidateUri, $candidateSha) }
            }
            $uri = ""; $sha = ""; $os = ""; $arch = ""; $rt = ""
        }
        if ($line -match '^\s*uri:\s*"?(.+?)"?\s*$') { $uri = $matches[1] }
        elseif ($line -match '^\s*sha256:\s*"?(.+?)"?\s*$') { $sha = $matches[1] }
        elseif ($line -match '^\s*os:\s*"?(.+?)"?\s*$') { $os = $matches[1] }
        elseif ($line -match '^\s*arch:\s*"?(.+?)"?\s*$') { $arch = $matches[1] }
        elseif ($line -match '^\s*runtime:\s*"?(.+?)"?\s*$') { $rt = $matches[1] }
    }
    if ($uri -and $sha -and $os -eq "windows" -and $arch -eq "amd64" -and $rt -eq $runtime) { $candidateUri = $uri; $candidateSha = $sha }
    if ($hasVersion -and $candidateUri -and $candidateSha) { return @($candidateUri, $candidateSha) }
    throw "no SCO package for runtime $runtime on windows/amd64"
}
function Copy-DirectoryContents($source, $destination) {
    New-Item -ItemType Directory -Force $destination | Out-Null
    foreach ($child in Get-ChildItem -LiteralPath $source -Force) {
        Copy-Item -LiteralPath $child.FullName -Destination $destination -Recurse -Force
    }
}
function Write-State($path, $regionCode, $runtime, $cachePath, $packageUri, $sha, $entrypoint) {
    New-Item -ItemType Directory -Force (Split-Path -Parent $path) | Out-Null
    $now = (Get-Date).ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ssZ")
    @"
registry_release_version: $(Yaml-Quote $version)
sco_version: $(Yaml-Quote $scoVersion)
expected_runtime: $(Yaml-Quote $runtime)
binary_runtime: $(Yaml-Quote $runtime)
region_code: $(Yaml-Quote $regionCode)
binary_path: $(Yaml-Quote $cachePath)
package_uri: $(Yaml-Quote $packageUri)
os: 'windows'
arch: 'amd64'
installed_at: $(Yaml-Quote $now)
region_entrypoint: $(Yaml-Quote $entrypoint)
sha256: $(Yaml-Quote $sha)
entrypoint_mode: 'copy'
last_verified_at: $(Yaml-Quote $now)
"@ | Set-Content -LiteralPath $path -Encoding UTF8
}
function Ensure-TransactionDirectory($path) {
    if (Test-Path -LiteralPath $path) {
        if (-not (Test-Path -LiteralPath $path -PathType Container)) {
            throw "expected directory but found file: $path"
        }
        return
    }

    $missing = @()
    $cursor = $path
    while ($cursor -and -not (Test-Path -LiteralPath $cursor)) {
        $missing = @($cursor) + $missing
        $parent = Split-Path -Parent $cursor
        if (-not $parent -or $parent -eq $cursor) { break }
        $cursor = $parent
    }
    foreach ($directory in $missing) {
        if (-not (Test-Path -LiteralPath $directory)) {
            New-Item -ItemType Directory -Path $directory | Out-Null
            [void]$script:createdDirectories.Add($directory)
        }
    }
}
function Publish-File($stagedPath, $targetPath) {
    if (-not (Test-Path -LiteralPath $stagedPath -PathType Leaf)) {
        throw "staged file not found: $stagedPath"
    }

    $parent = Split-Path -Parent $targetPath
    Ensure-TransactionDirectory $parent
    $leaf = Split-Path -Leaf $targetPath
    $temporary = Join-Path $parent ".$leaf.sco-install-$transactionId.tmp"
    $backup = Join-Path $parent ".$leaf.sco-install-$transactionId.bak"
    if ((Test-Path -LiteralPath $temporary) -or (Test-Path -LiteralPath $backup)) {
        throw "transaction path already exists for $targetPath"
    }

    $originalExists = Test-Path -LiteralPath $targetPath
    if ($originalExists -and (Test-Path -LiteralPath $targetPath -PathType Container)) {
        throw "expected file but found directory: $targetPath"
    }

    try {
        Copy-Item -LiteralPath $stagedPath -Destination $temporary
        $entry = [PSCustomObject]@{
            Kind = "file"
            Target = $targetPath
            Backup = $backup
            OriginalExists = $originalExists
        }
        # Register the target before the first live mutation so Ctrl-C can
        # always reach it from the outer transaction rollback.
        [void]$script:transactionEntries.Add($entry)
        if ($originalExists) {
            [IO.File]::Replace($temporary, $targetPath, $backup)
        } else {
            [IO.File]::Move($temporary, $targetPath)
        }
    } finally {
        Remove-Item -LiteralPath $temporary -Force -ErrorAction SilentlyContinue
    }
}
function Publish-Directory($stagedPath, $targetPath) {
    if (-not (Test-Path -LiteralPath $stagedPath -PathType Container)) {
        throw "staged directory not found: $stagedPath"
    }

    $parent = Split-Path -Parent $targetPath
    Ensure-TransactionDirectory $parent
    $leaf = Split-Path -Leaf $targetPath
    $temporary = Join-Path $parent ".$leaf.sco-install-$transactionId.tmp"
    $backup = Join-Path $parent ".$leaf.sco-install-$transactionId.bak"
    if ((Test-Path -LiteralPath $temporary) -or (Test-Path -LiteralPath $backup)) {
        throw "transaction path already exists for $targetPath"
    }

    $originalExists = Test-Path -LiteralPath $targetPath
    if ($originalExists -and -not (Test-Path -LiteralPath $targetPath -PathType Container)) {
        throw "expected directory but found file: $targetPath"
    }

    New-Item -ItemType Directory -Path $temporary | Out-Null
    try {
        Copy-DirectoryContents $stagedPath $temporary
        $entry = [PSCustomObject]@{
            Kind = "directory"
            Target = $targetPath
            Backup = $backup
            OriginalExists = $originalExists
        }
        # As with files, record the rollback target before the first rename.
        [void]$script:transactionEntries.Add($entry)
        if ($originalExists) {
            Move-Item -LiteralPath $targetPath -Destination $backup
            Move-Item -LiteralPath $temporary -Destination $targetPath
        } else {
            Move-Item -LiteralPath $temporary -Destination $targetPath
        }
    } finally {
        Remove-Item -LiteralPath $temporary -Recurse -Force -ErrorAction SilentlyContinue
    }
}
function Undo-Transaction {
    $rollbackErrors = @()
    $remainingEntries = New-Object System.Collections.ArrayList
    for ($i = $transactionEntries.Count - 1; $i -ge 0; $i--) {
        $entry = $transactionEntries[$i]
        try {
            if ($entry.OriginalExists) {
                # No backup means the live mutation never started. Preserve the
                # original target and consider this pending entry rolled back.
                if (-not (Test-Path -LiteralPath $entry.Backup)) { continue }

                if ($entry.Kind -eq "file") {
                    if (Test-Path -LiteralPath $entry.Target) {
                        if (Test-Path -LiteralPath $entry.Target -PathType Container) {
                            throw "expected file but found directory: $($entry.Target)"
                        }
                        [IO.File]::Replace($entry.Backup, $entry.Target, $null)
                    } else {
                        [IO.File]::Move($entry.Backup, $entry.Target)
                    }
                } else {
                    if (-not (Test-Path -LiteralPath $entry.Backup -PathType Container)) {
                        throw "directory backup not found: $($entry.Backup)"
                    }
                    if (Test-Path -LiteralPath $entry.Target) {
                        if (-not (Test-Path -LiteralPath $entry.Target -PathType Container)) {
                            throw "expected directory but found file: $($entry.Target)"
                        }
                        $failed = "$($entry.Target).sco-install-$transactionId.failed"
                        if (Test-Path -LiteralPath $failed) {
                            throw "rollback path already exists: $failed"
                        }
                        Move-Item -LiteralPath $entry.Target -Destination $failed
                        try {
                            Move-Item -LiteralPath $entry.Backup -Destination $entry.Target
                        } catch {
                            Move-Item -LiteralPath $failed -Destination $entry.Target
                            throw
                        }
                        Remove-Item -LiteralPath $failed -Recurse -Force -ErrorAction SilentlyContinue
                    } else {
                        Move-Item -LiteralPath $entry.Backup -Destination $entry.Target
                    }
                }
            } elseif (Test-Path -LiteralPath $entry.Target) {
                Remove-Item -LiteralPath $entry.Target -Recurse -Force
            }
        } catch {
            $rollbackErrors += "$($entry.Target): $($_.Exception.Message)"
            [void]$remainingEntries.Insert(0, $entry)
        }
    }

    $script:transactionEntries = $remainingEntries
    if ($rollbackErrors.Count -gt 0) {
        throw "rollback incomplete: $($rollbackErrors -join '; ')"
    }
    for ($i = $createdDirectories.Count - 1; $i -ge 0; $i--) {
        $directory = $createdDirectories[$i]
        if (Test-Path -LiteralPath $directory -PathType Container) {
            Remove-Item -LiteralPath $directory -Force -ErrorAction SilentlyContinue
        }
    }
    $createdDirectories.Clear()
}
function Complete-Transaction {
    foreach ($entry in $transactionEntries) {
        if ($entry.OriginalExists -and (Test-Path -LiteralPath $entry.Backup)) {
            Remove-Item -LiteralPath $entry.Backup -Recurse -Force -ErrorAction SilentlyContinue
        }
    }
    $transactionEntries.Clear()
    $createdDirectories.Clear()
}

for ($i = 0; $i -lt $args.Count; $i++) {
    $arg = $args[$i]
    if ($arg -match '^@(.+)$') { $version = $matches[1] }
    elseif ($arg -match '^--version=(.+)$') { $version = $matches[1] }
    elseif ($arg -eq '-v' -and $i + 1 -lt $args.Count) { $version = $args[++$i] }
}

if ($Env:SCO_HOME) { $scoRoot = $Env:SCO_HOME }
elseif ($Env:HOME) { $scoRoot = Join-Path $Env:HOME ".sco" }
elseif ($Env:USERPROFILE) { $scoRoot = Join-Path $Env:USERPROFILE ".sco" }
else { throw "Cannot determine home directory." }
if ($Env:SCO_DATA_HOME) { $dataRoot = $Env:SCO_DATA_HOME }
elseif ($Env:HOME) { $dataRoot = Join-Path $Env:HOME ".local\share\sco" }
else { $dataRoot = Join-Path $Env:USERPROFILE ".local\share\sco" }

$tmpRoot = Join-Path ([IO.Path]::GetTempPath()) ([IO.Path]::GetRandomFileName())
$binDir = Join-Path $scoRoot "bin"
$transactionId = ([Guid]::NewGuid()).ToString("N")
$lockDir = Join-Path $scoRoot ".install.lock"
$lockCandidate = Join-Path $scoRoot ".install-lock-$transactionId.tmp"
$lockMarkerName = "owner-$transactionId"
$lockMarker = Join-Path $lockDir $lockMarkerName
$script:transactionEntries = New-Object System.Collections.ArrayList
$script:createdDirectories = New-Object System.Collections.ArrayList
$script:promotionComplete = $false
$rollbackIncomplete = $false

try {
    New-Item -ItemType Directory -Force $scoRoot | Out-Null
    New-Item -ItemType Directory -Path $lockCandidate -ErrorAction Stop | Out-Null
    New-Item -ItemType File -Path (Join-Path $lockCandidate $lockMarkerName) -ErrorAction Stop | Out-Null
    try {
        # Directory.Move fails instead of nesting the candidate when the lock
        # already exists. The unique marker closes the Ctrl-C acquisition gap
        # and lets cleanup prove that this process still owns the lock.
        [IO.Directory]::Move($lockCandidate, $lockDir)
    } catch {
        throw "Another SCO installation is already in progress (lock: $lockDir)"
    }
    New-Item -ItemType Directory -Force $tmpRoot | Out-Null

    Write-Host "`nSCO installer`n"
    Pass "Detected platform: Windows (amd64)"

    Step "Resolve version" {
        $envTmp = Join-Path $tmpRoot "product.env"
        Download-File "$repo/$version/product.env" $envTmp
        $script:productEnv = Read-ProductEnv $envTmp
        $script:launcherVersion = $productEnv["LAUNCHER_VERSION"]
        if (-not $launcherVersion) { $script:launcherVersion = $productEnv["SCO_VERSION"] }
        $script:scoVersion = $productEnv["SCO_VERSION"]
    } {
        "Resolved version: $version (SCO $scoVersion)"
    }

    $manifestStageByRegion = @{}
    $cacheByRuntime = @{}
    $runtimeStageByRuntime = @{}
    $uriByRuntime = @{}
    $shaByRuntime = @{}
    $runtimeOrder = New-Object System.Collections.ArrayList

    Step "Download SCO" {
        Step "Load product catalog" {
        $script:productStage = Join-Path $tmpRoot "product.yaml"
        Download-File "$repo/$version/product.yaml" $productStage
        } -Silent

        Step "Load region configuration" {
        $metaArchive = Join-Path $tmpRoot "meta.tar.gz"
        $script:metaStage = Join-Path $tmpRoot "meta"
        New-Item -ItemType Directory -Force $metaStage | Out-Null
        Download-File "$repo/$version/meta/meta.tar.gz" $metaArchive
        & tar -zxf $metaArchive -C $metaStage
        if ($LASTEXITCODE -ne 0) { throw "failed to extract region configuration" }
        } -Silent

        Step "Cache component manifests" {
        $manifestsArchive = Join-Path $tmpRoot "manifests.tar.gz"
        $manifestsTmp = Join-Path $tmpRoot "manifests"
        New-Item -ItemType Directory -Force $manifestsTmp | Out-Null
        Download-File "$repo/$version/manifests/manifests.tar.gz" $manifestsArchive
        & tar -zxf $manifestsArchive -C $manifestsTmp
        if ($LASTEXITCODE -ne 0) { throw "failed to extract component manifests" }
        $script:scoManifest = Join-Path $manifestsTmp "sco.yaml"
        if (-not (Test-Path -LiteralPath $scoManifest -PathType Leaf)) {
            throw "sco.yaml not found in manifests archive"
        }
        foreach ($regionCode in ($productEnv["REGION_CODES"] -split ' ')) {
            if (-not $regionCode) { continue }
            $stage = Join-Path $tmpRoot "region-manifests\$regionCode"
            New-Item -ItemType Directory -Force $stage | Out-Null
            # v2 (one-binary) regions do not use components: ship only sco.yaml.
            # v1 regions get the full catalog.
            if ((Region-Runtime $productEnv $regionCode) -eq "v1") {
                Copy-DirectoryContents $manifestsTmp $stage
            } else {
                Copy-Item -LiteralPath $scoManifest -Destination $stage
            }
            $manifestStageByRegion[$regionCode] = $stage
        }
        } -Silent

        Step "Download launcher" {
        $launcherPlatform = Find-ScoPlatform $scoManifest $launcherVersion "launcher"
        $launcherUri = $launcherPlatform[0]
        $launcherSha = $launcherPlatform[1]
        $launcherArchive = Join-Path $tmpRoot "launcher.tar.gz"
        $launcherStageDir = Join-Path $tmpRoot "launcher"
        Download-File (Resolve-Url $launcherUri) $launcherArchive
        $actualSha = (Get-FileHash -Path $launcherArchive -Algorithm SHA256).Hash
        if ($actualSha -ne $launcherSha) { throw "sha256 mismatch for $launcherArchive" }
        New-Item -ItemType Directory -Force $launcherStageDir | Out-Null
        & tar -zxf $launcherArchive -C $launcherStageDir
        if ($LASTEXITCODE -ne 0) { throw "failed to extract launcher" }
        $script:launcherStage = Join-Path $launcherStageDir "sco.exe"
        if (-not (Test-Path -LiteralPath $launcherStage -PathType Leaf)) {
            throw "sco.exe not found after launcher extraction"
        }
        } -Silent

        Step "Cache runtime binaries" {
        foreach ($regionCode in ($productEnv["REGION_CODES"] -split ' ')) {
            if (-not $regionCode) { continue }
            $runtime = Region-Runtime $productEnv $regionCode
            if (-not $runtime -or $cacheByRuntime.ContainsKey($runtime)) { continue }
            $platform = Find-ScoPlatform $scoManifest $scoVersion $runtime
            $pkgUri = $platform[0]; $sha = $platform[1]
            $cachePath = Join-Path $scoRoot "runtimes\$version\$scoVersion\$runtime\windows\amd64\sco.exe"
            $archive = Join-Path $tmpRoot "sco-$runtime.tar.gz"
            $stage = Join-Path $tmpRoot "runtime-$runtime"
            Download-File (Resolve-Url $pkgUri) $archive
            $actualSha = (Get-FileHash -Path $archive -Algorithm SHA256).Hash
            if ($actualSha -ne $sha) { throw "sha256 mismatch for $archive" }
            New-Item -ItemType Directory -Force $stage | Out-Null
            & tar -zxf $archive -C $stage
            if ($LASTEXITCODE -ne 0) { throw "failed to extract runtime $runtime" }
            $runtimeStage = Join-Path $stage "sco.exe"
            if (-not (Test-Path -LiteralPath $runtimeStage -PathType Leaf)) {
                throw "runtime binary not found in package for $runtime"
            }
            $cacheByRuntime[$runtime] = $cachePath
            $runtimeStageByRuntime[$runtime] = $runtimeStage
            $uriByRuntime[$runtime] = $pkgUri
            $shaByRuntime[$runtime] = $sha
            [void]$runtimeOrder.Add($runtime)
        }
        } -Silent
    }

    $entrypointStageByRegion = @{}
    $stateStageByRegion = @{}
    $entrypointByRegion = @{}
    Step "Link region entrypoints" {
        foreach ($regionCode in ($productEnv["REGION_CODES"] -split ' ')) {
            if (-not $regionCode) { continue }
            $runtime = Region-Runtime $productEnv $regionCode
            if (-not $runtime) { continue }
            if (-not $runtimeStageByRuntime.ContainsKey($runtime)) {
                throw "no staged cache entry for runtime $runtime"
            }
            $entrypoint = Join-Path $binDir "$regionCode\sco.exe"
            $entrypointStage = Join-Path $tmpRoot "entrypoints\$regionCode\sco.exe"
            New-Item -ItemType Directory -Force (Split-Path -Parent $entrypointStage) | Out-Null
            Copy-Item -LiteralPath $runtimeStageByRuntime[$runtime] -Destination $entrypointStage
            $stateStage = Join-Path $tmpRoot "state\$regionCode\runtime.yaml"
            Write-State $stateStage $regionCode $runtime $cacheByRuntime[$runtime] $uriByRuntime[$runtime] $shaByRuntime[$runtime] $entrypoint
            $entrypointStageByRegion[$regionCode] = $entrypointStage
            $stateStageByRegion[$regionCode] = $stateStage
            $entrypointByRegion[$regionCode] = $entrypoint
        }
    } -Silent

    Step "Commit installation" {
        try {
            Publish-File $productStage (Join-Path $dataRoot "product.yaml")
            Publish-Directory $metaStage (Join-Path $dataRoot "meta")
            foreach ($regionCode in ($productEnv["REGION_CODES"] -split ' ')) {
                if (-not $regionCode) { continue }
                Publish-Directory $manifestStageByRegion[$regionCode] (Join-Path $dataRoot "regions\$regionCode\manifests")
            }
            foreach ($runtime in $runtimeOrder) {
                Publish-File $runtimeStageByRuntime[$runtime] $cacheByRuntime[$runtime]
            }
            foreach ($regionCode in ($productEnv["REGION_CODES"] -split ' ')) {
                if (-not $regionCode -or -not $entrypointStageByRegion.ContainsKey($regionCode)) { continue }
                Publish-File $entrypointStageByRegion[$regionCode] $entrypointByRegion[$regionCode]
                Publish-File $stateStageByRegion[$regionCode] (Join-Path $scoRoot "state\regions\$regionCode\runtime.yaml")
            }
            # The launcher is the final visible commit point. If it fails, all
            # product, metadata, manifests, runtimes, entrypoints, and state are
            # restored from their transaction backups.
            Publish-File $launcherStage (Join-Path $binDir "sco.exe")
            # Mark the complete artifact set visible before backup cleanup.
            # An interruption after this point may leave disposable backups,
            # but must not roll back a fully promoted release.
            $script:promotionComplete = $true
            Complete-Transaction
        } catch {
            $promotionError = $_
            if (-not $promotionComplete) {
                try {
                    Undo-Transaction
                } catch {
                    throw "$($promotionError.Exception.Message); $($_.Exception.Message)"
                }
            }
            throw $promotionError
        }
    } -Silent

    Write-Host "`nSCO $scoVersion installed successfully`n"
    Write-Host "Next: Run sco init"
    Write-Host 'Optional: Enable Tab completion with "sco completion powershell --help"'
    if ($Env:PATH -notlike "*$binDir*") { Write-Host "`nPATH: Add $binDir to your user PATH" }
    Write-Host ""
} finally {
    if (-not $promotionComplete -and $transactionEntries.Count -gt 0) {
        try {
            Undo-Transaction
        } catch {
            $rollbackIncomplete = $true
            Write-Warning "Failed to restore the complete previous installation: $($_.Exception.Message)"
        }
    } elseif ($promotionComplete -and $transactionEntries.Count -gt 0) {
        Complete-Transaction
    }
    Remove-Item -LiteralPath $tmpRoot -Recurse -Force -ErrorAction SilentlyContinue
    $ownsLock = Test-Path -LiteralPath $lockMarker -PathType Leaf
    if ($ownsLock -and -not $rollbackIncomplete) {
        Remove-Item -LiteralPath $lockDir -Recurse -Force -ErrorAction SilentlyContinue
        if (Test-Path -LiteralPath $lockDir) {
            Write-Warning "Failed to remove installer lock: $lockDir"
        }
    } elseif ($rollbackIncomplete) {
        Write-Warning "Installer lock was preserved for recovery: $lockDir"
    }
    Remove-Item -LiteralPath $lockCandidate -Recurse -Force -ErrorAction SilentlyContinue
}

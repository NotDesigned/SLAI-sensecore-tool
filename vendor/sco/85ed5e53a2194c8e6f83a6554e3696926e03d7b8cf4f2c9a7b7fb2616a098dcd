    [ -f "$launcher_stage/$bin_name" ] || die "sco binary not found after extraction: $launcher_stage/$bin_name"
    chmod 755 "$launcher_stage/$bin_name" || die "Failed to set launcher permissions"
    [ "$os" = darwin ] && xattr -d com.apple.quarantine "$launcher_stage/$bin_name" 2> /dev/null || true

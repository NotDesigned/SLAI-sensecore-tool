load_region_configuration() {
    meta_url="$repo/$version/meta/meta.tar.gz"
    meta_archive="$tmpdir/meta.tar.gz"
    meta_stage="$staging_root/meta"
    download_file "$meta_url" "$meta_archive" || die "Failed to download $meta_url"
    mkdir -p "$meta_stage" || die "Failed to create region configuration staging directory"
    tar -xzf "$meta_archive" -C "$meta_stage" || die "Failed to extract region configuration"
    add_promotion dir "$meta_stage" "$data_root/meta"
}

cache_component_manifests() {
    manifests_url="$repo/$version/manifests/manifests.tar.gz"
    manifests_archive="$tmpdir/manifests.tar.gz"
    manifests_tmp="$staging_root/manifests-source"
    manifests_regions="$staging_root/region-manifests"
    download_file "$manifests_url" "$manifests_archive" || die "Failed to download $manifests_url"
    mkdir -p "$manifests_tmp" "$manifests_regions" || die "Failed to create component manifest staging directories"
    tar -xzf "$manifests_archive" -C "$manifests_tmp" || die "Failed to extract component manifests"
    [ -f "$manifests_tmp/sco.yaml" ] || die "sco.yaml not found in manifests archive"

    for region_code in $REGION_CODES; do
        final_dir="$regions_root/$region_code/manifests"
        region_stage="$manifests_regions/$region_code"
        # v2 (one-binary) regions do not use components: ship only sco.yaml so
        # the region's manifests dir carries no installable component manifests.
        # v1 regions get the full catalog. The downloaded archive always carries
        # the full set (registry does not filter by runtime, so a single archive
        # satisfies a cross-runtime group); per-region runtime decides what lands
        # on disk.
        if [ "$(region_runtime "$region_code")" = "v1" ]; then
            copy_dir_contents "$manifests_tmp" "$region_stage" || die "Failed to stage component manifests for $region_code"
        else
            mkdir -p "$region_stage" || die "Failed to stage component manifests for $region_code"
            cp "$manifests_tmp/sco.yaml" "$region_stage/sco.yaml" || die "Failed to stage sco.yaml for $region_code"
        fi
        add_promotion dir "$region_stage" "$final_dir"
    done
    sco_manifest="$manifests_tmp/sco.yaml"
}

install_runtime_cache() {
    runtime=$1
    platform=$(find_sco_platform "$sco_manifest" "$sco_version" "$runtime" "$os" "$arch")
    [ -n "$platform" ] || die "no SCO package for runtime $runtime on $os/$arch"
    package_uri=$(printf '%s' "$platform" | awk -F '\t' '{print $1}')
    package_sha=$(printf '%s' "$platform" | awk -F '\t' '{print $2}')
    package_url=$(resolve_url "$package_uri")
    cache_path="$sco_home/runtimes/$version/$sco_version/$runtime/$os/$arch/$bin_name"

    archive="$tmpdir/sco-$runtime.tar.gz"
    staging="$staging_root/runtime-$runtime"
    download_file "$package_url" "$archive" resume || die "Failed to download $package_url"
    verify_sha256 "$archive" "$package_sha"
    mkdir -p "$staging" || die "Failed to create runtime staging directory for $runtime"
    tar -xzf "$archive" -C "$staging" || die "Failed to extract runtime $runtime"
    [ -f "$staging/$bin_name" ] || die "runtime binary not found in package for $runtime"
    chmod 755 "$staging/$bin_name" || die "Failed to set runtime permissions for $runtime"
    [ "$os" = darwin ] && xattr -d com.apple.quarantine "$staging/$bin_name" 2> /dev/null || true
    add_promotion exec "$staging/$bin_name" "$cache_path"

    printf '%s\t%s\t%s\n' "$runtime" "$cache_path" "$package_uri" >> "$runtime_map" || die "Failed to record runtime cache"
    printf '%s\t%s\n' "$runtime" "$package_sha" >> "$sha_map" || die "Failed to record runtime checksum"
}

cache_runtime_binaries() {
    : > "$runtime_map" || die "Failed to initialize runtime cache map"
    : > "$sha_map" || die "Failed to initialize runtime checksum map"
    seen=" "
    for region_code in $REGION_CODES; do
        runtime=$(region_runtime "$region_code")
        [ -n "$runtime" ] || continue
        case "$seen" in
        *" $runtime "*) continue ;;
        esac
        install_runtime_cache "$runtime"
        seen="$seen$runtime "
    done
}

verify_staged_launcher() {
    platform=$(find_sco_platform "$sco_manifest" "$launcher_version" launcher "$os" "$arch")
    [ -n "$platform" ] || die "no SCO launcher package for $os/$arch"
    launcher_sha=$(printf '%s' "$platform" | awk -F '\t' '{print $2}')
    [ -n "$launcher_sha" ] || die "no checksum for SCO launcher on $os/$arch"
    verify_sha256 "$launcher_archive" "$launcher_sha"
}

runtime_cache_path() {
    awk -F '\t' -v runtime="$1" '$1 == runtime {print $2; exit}' "$runtime_map"
}

runtime_package_uri() {
    awk -F '\t' -v runtime="$1" '$1 == runtime {print $3; exit}' "$runtime_map"
}

runtime_sha() {
    awk -F '\t' -v runtime="$1" '$1 == runtime {print $2; exit}' "$sha_map"
}

stage_runtime_state() {
    region_code=$1
    runtime=$2
    cache_path=$3
    package_uri=$4
    package_sha=$5
    entrypoint=$6
    state_path="$sco_home/state/regions/$region_code/runtime.yaml"
    state_stage_dir="$staging_root/runtime-state/$region_code"
    state_stage="$state_stage_dir/runtime.yaml"
    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    mkdir -p "$state_stage_dir" || die "Failed to create runtime state staging directory for $region_code"
    cat > "$state_stage" << EOF || die "Failed to stage runtime state for $region_code"
registry_release_version: "$version"
sco_version: "$sco_version"
expected_runtime: "$runtime"
binary_runtime: "$runtime"
region_code: "$region_code"
binary_path: "$cache_path"
package_uri: "$package_uri"
os: "$os"
arch: "$arch"
installed_at: "$now"
region_entrypoint: "$entrypoint"
sha256: "$package_sha"
entrypoint_mode: "symlink"
last_verified_at: "$now"
EOF
    chmod 600 "$state_stage" || die "Failed to set runtime state permissions for $region_code"
    add_promotion state "$state_stage" "$state_path"
}

link_region_entrypoints() {
    for region_code in $REGION_CODES; do
        runtime=$(region_runtime "$region_code")
        [ -n "$runtime" ] || continue
        cache_path=$(runtime_cache_path "$runtime")
        package_uri=$(runtime_package_uri "$runtime")
        package_sha=$(runtime_sha "$runtime")
        [ -n "$cache_path" ] || die "no cache entry for runtime $runtime"
        entrypoint="$bin_dir/$region_code/$bin_name"
        if [ -e "$entrypoint" ] && [ ! -L "$entrypoint" ]; then
            die "entrypoint path is occupied by a non-symlink: $entrypoint"
        fi
        add_promotion link "$cache_path" "$entrypoint"
        stage_runtime_state "$region_code" "$runtime" "$cache_path" "$package_uri" "$package_sha" "$entrypoint"
    done
}

remove_path() {
    path=$1
    if [ -d "$path" ] && [ ! -L "$path" ]; then
        rm -rf "$path"
    else
        rm -f "$path"
    fi
}

ensure_destination_dir() {
    destination_dir=$1
    probe=$destination_dir
    while [ ! -d "$probe" ]; do
        if [ -e "$probe" ] || [ -L "$probe" ]; then
            fail "Destination parent is not a directory: $probe"
            return 1
        fi
        printf '%s\n' "$probe" >> "$created_dirs" || return 1
        parent=$(dirname "$probe") || return 1
        [ "$parent" != "$probe" ] || return 1
        probe=$parent
    done
    mkdir -p "$destination_dir" || return 1
}

preflight_promotions() {
    [ -s "$promotion_map" ] || die "No staged installation content"
    launcher_count=$(awk -F '\t' '$1 == "launcher" {count++} END {print count + 0}' "$promotion_map") ||
        die "Failed to inspect staged launcher"
    [ "$launcher_count" = 1 ] || die "Expected exactly one staged launcher"
    awk -F '\t' '++seen[$3] > 1 {exit 1}' "$promotion_map" ||
        die "Duplicate live path in staged installation"

    while IFS="$(printf '\t')" read -r kind source target; do
        case "$kind" in
        launcher | exec | file | state)
            [ -f "$source" ] || die "Staged file is missing: $source"
            ;;
        dir)
            [ -d "$source" ] && [ ! -L "$source" ] || die "Staged directory is missing: $source"
            ;;
        link)
            [ -n "$source" ] || die "Staged link target is empty: $target"
            ;;
        *)
            die "Unknown staged installation type: $kind"
            ;;
        esac

        if [ "$kind" = dir ] && { [ -e "$target" ] || [ -L "$target" ]; } &&
            { [ ! -d "$target" ] || [ -L "$target" ]; }; then
            die "Directory path is occupied by another file type: $target"
        fi
        if [ "$kind" = link ] && { [ -e "$target" ] || [ -L "$target" ]; } &&
            { [ ! -L "$target" ] || [ -d "$target" ]; }; then
            die "Entrypoint path is occupied by an unsupported file type: $target"
        fi
        if [ "$kind" != dir ] && [ "$kind" != link ] &&
            { [ -e "$target" ] || [ -L "$target" ]; } &&
            { [ -d "$target" ] || { [ ! -f "$target" ] && [ ! -L "$target" ]; }; }; then
            die "File path is occupied by an unsupported file type: $target"
        fi

        prepared="$target.sco-install-new.$$"
        backup="$target.sco-install-backup.$$"
        if [ -e "$prepared" ] || [ -L "$prepared" ] || [ -e "$backup" ] || [ -L "$backup" ]; then
            die "Transaction path already exists next to $target"
        fi
    done < "$promotion_map"

    while IFS="$(printf '\t')" read -r kind source target; do
        target_parent=$(dirname "$target") || die "Failed to resolve parent for $target"
        ensure_destination_dir "$target_parent" || die "Failed to prepare destination directory: $target_parent"
    done < "$promotion_map"

    while IFS="$(printf '\t')" read -r kind source target; do
        target_parent=$(dirname "$target") || die "Failed to resolve parent for $target"
        [ -d "$target_parent" ] && [ -w "$target_parent" ] ||
            die "Destination directory is not writable: $target_parent"
        prepared="$target.sco-install-new.$$"
        backup="$target.sco-install-backup.$$"
        if [ -e "$prepared" ] || [ -L "$prepared" ] || [ -e "$backup" ] || [ -L "$backup" ]; then
            die "Transaction path appeared next to $target"
        fi
    done < "$promotion_map"
}

prepare_promotions() {
    : > "$prepared_map" || return 1
    while IFS="$(printf '\t')" read -r kind source target; do
        prepared="$target.sco-install-new.$$"
        backup="$target.sco-install-backup.$$"
        had_old=0
        if [ -e "$target" ] || [ -L "$target" ]; then
            had_old=1
        fi
        printf '%s\t%s\t%s\t%s\t%s\n' "$kind" "$prepared" "$target" "$backup" "$had_old" >> "$prepared_map" ||
            return 1
        case "$kind" in
        launcher | exec)
            cp "$source" "$prepared" || return 1
            chmod 755 "$prepared" || return 1
            ;;
        file)
            cp "$source" "$prepared" || return 1
            chmod 644 "$prepared" || return 1
            ;;
        state)
            cp "$source" "$prepared" || return 1
            chmod 600 "$prepared" || return 1
            ;;
        dir)
            mkdir "$prepared" || return 1
            copy_dir_contents "$source" "$prepared" || return 1
            ;;
        link)
            ln -s "$source" "$prepared" || return 1
            ;;
        *)
            return 1
            ;;
        esac
    done < "$promotion_map"
}

validate_prepared_promotions() {
    while IFS="$(printf '\t')" read -r kind prepared target backup had_old; do
        case "$kind" in
        launcher | exec)
            [ -f "$prepared" ] && [ -x "$prepared" ] || return 1
            ;;
        file | state)
            [ -f "$prepared" ] || return 1
            ;;
        dir)
            [ -d "$prepared" ] && [ ! -L "$prepared" ] || return 1
            ;;
        link)
            [ -L "$prepared" ] || return 1
            ;;
        *)
            return 1
            ;;
        esac
        [ ! -e "$backup" ] && [ ! -L "$backup" ] || return 1
        if [ "$had_old" = 1 ]; then
            [ -e "$target" ] || [ -L "$target" ] || return 1
        else
            [ ! -e "$target" ] && [ ! -L "$target" ] || return 1
        fi
    done < "$prepared_map"
}

backup_live_targets() {
    while IFS="$(printf '\t')" read -r kind prepared target backup had_old; do
        if [ "$had_old" = 1 ]; then
            [ -e "$target" ] || [ -L "$target" ] || return 1
            if [ "$kind" = dir ]; then
                # Directories are renamed to their backup only at their own
                # promotion point, keeping them live throughout preparation.
                :
            elif [ -L "$target" ]; then
                # Preserve the live entrypoint until its prepared sibling
                # symlink is atomically renamed over it.
                if ! cp -P "$target" "$backup"; then
                    remove_path "$backup" || true
                    return 1
                fi
            else
                # Files stay live while a byte-for-byte rollback copy is made.
                if ! cp -p "$target" "$backup"; then
                    remove_path "$backup" || true
                    return 1
                fi
            fi
        else
            [ ! -e "$target" ] && [ ! -L "$target" ] || return 1
        fi
    done < "$prepared_map"
}

promote_prepared_targets() {
    requested_kind=$1
    while IFS="$(printf '\t')" read -r kind prepared target backup had_old; do
        if [ "$requested_kind" = launcher ]; then
            [ "$kind" = launcher ] || continue
        else
            [ "$kind" != launcher ] || continue
        fi
        if [ "$kind" = dir ] && [ "$had_old" = 1 ]; then
            mv "$target" "$backup" || return 1
        fi
        # prepared is a sibling of target. mv therefore atomically switches a
        # single file or link and never removes a live entrypoint first.
        mv "$prepared" "$target" || return 1
    done < "$prepared_map"
}

rollback_transaction() {
    rollback_ok=1
    if [ -n "$prepared_map" ] && [ -f "$prepared_map" ]; then
        while IFS="$(printf '\t')" read -r kind prepared target backup had_old; do
            if [ "$had_old" = 1 ]; then
                # A still-present prepared path means this target was never
                # promoted. Leave the live target alone and discard its backup
                # during cleanup. A missing live directory also needs restore
                # when its backup rename succeeded but the prepared rename
                # failed.
                if { [ ! -e "$prepared" ] && [ ! -L "$prepared" ]; } ||
                    { [ ! -e "$target" ] && [ ! -L "$target" ]; }; then
                    if [ -e "$backup" ] || [ -L "$backup" ]; then
                        if [ "$kind" = dir ] && { [ -e "$target" ] || [ -L "$target" ]; }; then
                            remove_path "$target" || rollback_ok=0
                        fi
                        if [ "$kind" != dir ] || { [ ! -e "$target" ] && [ ! -L "$target" ]; }; then
                            mv "$backup" "$target" || rollback_ok=0
                        fi
                    else
                        rollback_ok=0
                    fi
                fi
            elif [ ! -e "$prepared" ] && [ ! -L "$prepared" ] &&
                { [ -e "$target" ] || [ -L "$target" ]; }; then
                remove_path "$target" || rollback_ok=0
            fi
        done < "$prepared_map"
    fi
    if [ "$rollback_ok" = 1 ]; then
        transaction_started=0
        pass "Restored previous installation"
        return 0
    fi
    fail "Failed to restore the complete previous installation"
    return 1
}

cleanup_transaction_artifacts() {
    [ -n "$prepared_map" ] && [ -f "$prepared_map" ] || return 0
    while IFS="$(printf '\t')" read -r kind prepared target backup had_old; do
        if [ -e "$prepared" ] || [ -L "$prepared" ]; then
            remove_path "$prepared" || true
        fi
        if [ -e "$backup" ] || [ -L "$backup" ]; then
            remove_path "$backup" || true
        fi
    done < "$prepared_map"
    return 0
}

cleanup_created_dirs() {
    [ "$transaction_committed" != 1 ] || return 0
    [ -n "$created_dirs" ] && [ -f "$created_dirs" ] || return 0
    while IFS= read -r created_dir; do
        [ -n "$created_dir" ] || continue
        rmdir "$created_dir" 2> /dev/null || true
    done < "$created_dirs"
    return 0
}

install_staged_release() {
    verify_staged_launcher
    preflight_promotions
    prepare_promotions || die "Failed to prepare installation transaction"
    validate_prepared_promotions || die "Installation transaction failed final preflight"

    if ! backup_live_targets; then
        return 1
    fi
    transaction_started=1
    if ! promote_prepared_targets nonlauncher; then
        return 1
    fi
    # The launcher is deliberately switched only after runtimes, entrypoints,
    # runtime state, and release metadata have all been promoted successfully.
    if ! promote_prepared_targets launcher; then
        return 1
    fi
    transaction_committed=1
    transaction_started=0
    return 0
}

download_sco() {
    download_launcher || return 1
    load_product_catalog || return 1
    load_region_configuration || return 1
    cache_component_manifests || return 1
    cache_runtime_binaries || return 1
}

while getopts v: opt; do
    case "$opt" in
    v) version="$OPTARG" ;;
    esac
done
for arg in "$@"; do
    case "$arg" in
    @*) version="${arg#@}" ;;
    --version=*) version="${arg#--version=}" ;;
    esac
done
if [ -z "${version-}" ]; then
    version="20260830"
fi

case "$(uname -s)" in
Linux) os=linux ;;
Darwin) os=darwin ;;
MINGW*) os=windows ;;
*) die "OS $(uname -s) not supported." ;;
esac
case "$(uname -m)" in
amd64 | x86_64) arch=amd64 ;;
arm64 | aarch64) arch=arm64 ;;
*) die "Architecture $(uname -m) not supported." ;;
esac
case "$os" in
linux) platform_name=Linux ;;
darwin) platform_name=macOS ;;
windows) platform_name=Windows ;;
esac

command -v curl > /dev/null || die "please install 'curl' before proceeding."
command -v tar > /dev/null || die "please install 'tar' before proceeding."
command -v awk > /dev/null || die "please install 'awk' before proceeding."

: "${HOME:?"HOME is not set"}"
: "${SCO_HOME:="$HOME/.sco"}" && export SCO_HOME
: "${SCO_DATA_HOME:="$HOME/.local/share/sco"}"
sco_home="$SCO_HOME"
data_root="$SCO_DATA_HOME"
regions_root="$data_root/regions"
bin_dir="$sco_home/bin"
bin_name="sco"
[ "$os" = windows ] && bin_name="sco.exe"

mkdir -p "$sco_home" || die "Failed to prepare SCO_HOME: $sco_home"
install_lock="$sco_home/.install.lock"
# Do not allow a termination signal between successful mkdir and recording
# ownership; otherwise an empty stale lock could survive forever.
trap '' HUP INT TERM
if mkdir "$install_lock" 2> /dev/null; then
    install_lock_acquired=1
    trap on_signal HUP INT TERM
else
    trap on_signal HUP INT TERM
    die "Another SCO installation is already in progress (lock: $install_lock)"
fi

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/sco-install.XXXXXX")
staging_root="$tmpdir/staging"
mkdir -p "$staging_root" || die "Failed to create installation staging directory"
promotion_map="$tmpdir/promotion-map.tsv"
prepared_map="$tmpdir/prepared-map.tsv"
created_dirs="$tmpdir/created-dirs.txt"
runtime_map="$tmpdir/runtime-map.tsv"
sha_map="$tmpdir/runtime-sha.tsv"
: > "$promotion_map" || die "Failed to initialize installation transaction"
: > "$created_dirs" || die "Failed to initialize destination directory tracking"
copy_counter=0
sco_manifest=

printf '\nSCO installer\n\n'
pass "Detected platform: $platform_name ($arch)"
start_spinner 'Resolve version'
resolve_release
stop_spinner
pass "Resolved version: $version (SCO $sco_version)"
run_step 'Download SCO' download_sco || exit 1
link_region_entrypoints || exit 1
install_staged_release || exit 1

printf '\nSCO %s installed successfully\n\n' "$sco_version"
printf 'Next: Run sco init\n'
printf 'Optional: Enable Tab completion with "sco completion SHELL --help"\n'
case ":${PATH-}:" in
*:"$bin_dir":*) ;;
*) printf '\nPATH: Add %s to your shell profile\n' "$bin_dir" ;;
esac
printf '\n'

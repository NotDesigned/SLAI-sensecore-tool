    sco_version="${SCO_VERSION:-$launcher_version}"
}

add_promotion() {
    kind=$1
    source=$2
    target=$3
    printf '%s\t%s\t%s\n' "$kind" "$source" "$target" >> "$promotion_map" || die "Failed to record staged installation"
}

load_product_catalog() {

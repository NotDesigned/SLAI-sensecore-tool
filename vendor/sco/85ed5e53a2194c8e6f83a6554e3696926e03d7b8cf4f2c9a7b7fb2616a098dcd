#!/bin/sh
# Generated by sco registry generator — https://sco.sensecore.cn/registry, default version 20260830
set -eu

repo='https://sco.sensecore.cn/registry'
version='20260830'

die() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

pass() {
    printf '✓ %s\n' "$1"
}

fail() {
    printf '✗ %s\n' "$1" >&2
}

is_tty() {
    [ -t 1 ]
}

spinner_pid=
start_spinner() {
    [ -z "${spinner_pid-}" ] || return 0
    is_tty || return 0
    message=$1
    {
        while :; do
            for frame in '⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏'; do
                printf '\r%s %s...' "$frame" "$message"
                sleep 0.08
            done
        done
    } &
    spinner_pid=$!
}

stop_spinner() {
    [ -n "${spinner_pid-}" ] || return 0
    kill "$spinner_pid" 2> /dev/null || true
    wait "$spinner_pid" 2> /dev/null || true
    spinner_pid=
    if is_tty; then
        printf '\r\033[K'
    fi
    return 0
}

run_step() {
    name=$1
    shift
    start_spinner "$name"
    if "$@"; then
        stop_spinner
        pass "$name"
        return 0
    fi
    stop_spinner
    fail "$name"
    return 1
}

tmpdir=
promotion_map=
prepared_map=
created_dirs=
install_lock=
install_lock_acquired=0
transaction_started=0
transaction_committed=0
preserve_transaction_artifacts=0
cleanup() {
    # EXIT is the single cleanup path. Ignore further termination signals while
    # rollback is in progress so they cannot re-enter cleanup and remove backups
    # that the first rollback still needs.
    trap - EXIT
    trap '' HUP INT TERM
    stop_spinner
    if [ "$transaction_started" = 1 ] && [ "$transaction_committed" != 1 ]; then
        rollback_transaction || preserve_transaction_artifacts=1
    fi
    if [ "$preserve_transaction_artifacts" != 1 ]; then
        cleanup_transaction_artifacts
        cleanup_created_dirs
        [ -z "${tmpdir-}" ] || rm -rf "$tmpdir"
        if [ "$install_lock_acquired" = 1 ]; then
            rmdir "$install_lock" 2> /dev/null || fail "Failed to remove installer lock: $install_lock"
        fi
    else
        fail "Rollback incomplete; recovery files and installer lock were preserved (temporary data: $tmpdir)"
    fi
}

on_signal() {
    exit 1
}

trap cleanup EXIT
trap on_signal HUP INT TERM

download_file() {
    url=$1
    out=$2
    resumable=${3:-}
    error_file="$out.curl-error"
    attempt=1

    while :; do
        status=0
        if [ "$resumable" = resume ]; then
            curl -sSfL --fail -C - "$url" -o "$out" 2> "$error_file" || status=$?
        else
            rm -f "$out"
            curl -sSfL --fail "$url" -o "$out" 2> "$error_file" || status=$?
        fi
        if [ "$status" -eq 0 ]; then
            rm -f "$error_file"
            return 0
        fi
        if [ "$attempt" -ge 10 ]; then
            stop_spinner
            [ ! -s "$error_file" ] || cat "$error_file" >&2
            rm -f "$error_file"
            return "$status"
        fi
        attempt=$((attempt + 1))
        sleep 2
    done
}

sha256_file() {
    if command -v sha256sum > /dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum > /dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        die "please install 'sha256sum' or 'shasum' before proceeding."
    fi
}

verify_sha256() {
    file=$1
    want=$2
    got=$(sha256_file "$file")
    [ "$got" = "$want" ] || die "sha256 mismatch for $file"
}

upper_region_code() {
    printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_'
}

region_runtime() {
    key=$(upper_region_code "$1")
    eval "printf '%s' \"\${REGION_${key}_RUNTIME:-}\""
}

resolve_url() {
    uri=$1
    case "$uri" in
    http://* | https://*) printf '%s' "$uri" ;;
    /*) printf '%s%s' "$repo" "$uri" ;;
    *) printf '%s/%s' "$repo" "$uri" ;;
    esac
}

find_sco_platform() {
    manifest=$1
    want_version=$2
    want_runtime=$3
    want_os=$4
    want_arch=$5
    awk -v want_version="$want_version" -v want_runtime="$want_runtime" -v want_os="$want_os" -v want_arch="$want_arch" '
        function trim(v) {
            gsub(/^[[:space:]"'\''"]+|[[:space:],"'\''"]+$/, "", v)
            return v
        }
        function reset_platform() {
            uri = ""; sha = ""; os = ""; arch = ""; runtime = ""
        }
        function maybe_emit() {
            if (uri != "" && sha != "" && os == want_os && arch == want_arch && runtime == want_runtime) {
                candidate_uri = uri
                candidate_sha = sha
                if (has_want_version) {
                    print candidate_uri "\t" candidate_sha
                    found = 1
                    exit
                }
            }
        }
        function maybe_emit_candidate() {
            if (has_want_version && candidate_uri != "" && candidate_sha != "") {
                print candidate_uri "\t" candidate_sha
                found = 1
                exit
            }
        }
        /^[[:space:]]*(-[[:space:]]*)?version:/ {
            maybe_emit()
            value = trim(substr($0, index($0, ":") + 1))
            if (value == want_version) {
                has_want_version = 1
                maybe_emit_candidate()
            }
            reset_platform()
            next
        }
        /^[[:space:]]*-[[:space:]]/ {
            maybe_emit()
            reset_platform()
        }
        /^[[:space:]]*uri:/ {
            uri = trim(substr($0, index($0, ":") + 1))
            next
        }
        /^[[:space:]]*sha256:/ {
            sha = trim(substr($0, index($0, ":") + 1))
            next
        }
        /^[[:space:]]*os:/ {
            os = trim(substr($0, index($0, ":") + 1))
            next
        }
        /^[[:space:]]*arch:/ {
            arch = trim(substr($0, index($0, ":") + 1))
            next
        }
        /^[[:space:]]*runtime:/ {
            runtime = trim(substr($0, index($0, ":") + 1))
            next
        }
        END {
            if (!found) {
                maybe_emit()
                maybe_emit_candidate()
            }
        }
    ' "$manifest"
}

copy_dir_contents() {
    src=$1
    dst=$2
    copy_counter=$((copy_counter + 1))
    copy_archive="$tmpdir/copy-dir-$copy_counter.tar"
    tar -cf "$copy_archive" -C "$src" . || return 1
    mkdir -p "$dst" || return 1
    tar -xf "$copy_archive" -C "$dst" || return 1
    rm -f "$copy_archive" || return 1
}

resolve_release() {
    env_url="$repo/$version/product.env"
    env_tmp="$tmpdir/product.env"

    download_file "$env_url" "$env_tmp" || die "Failed to download $env_url"
    # shellcheck disable=SC1090

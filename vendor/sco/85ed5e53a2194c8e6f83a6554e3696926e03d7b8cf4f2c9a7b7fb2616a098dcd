download_launcher() {
    launcher_url="$repo/$version/packages/sco/$launcher_version/launcher/$os/$arch/sco-$launcher_version-launcher-$os-$arch.tar.gz"
    launcher_archive="$tmpdir/launcher.tar.gz"
